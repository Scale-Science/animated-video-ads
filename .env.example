# kie.ai API key — used for image (Nano Banana Pro) and video (Kling 3.0) generation
# and for the file upload API. Get one at https://kie.ai
KIE_API_KEY=

# Anthropic API key — used for the Stage 1 script -> storyboard step.
ANTHROPIC_API_KEY=

# Optional overrides
PORT=3000
# Model for the storyboard step (default: claude-opus-4-8)
STORYBOARD_MODEL=
